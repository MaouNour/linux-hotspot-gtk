#!/bin/bash
# gnome-hotspot-helper — root-side wrapper around create_ap, supervised by systemd.
#
# This script is only ever meant to be invoked via `pkexec` (see the
# accompanying .policy file, which pins pkexec to this exact path). It is
# installed root:root mode 0755 so an unprivileged user can't tamper with it
# and then have pkexec run their version as root.
#
# WHY SYSTEMD: earlier versions of this helper tracked create_ap's daemon
# mode by hand (--daemon + a pidfile, then pkill loops to clean up before a
# restart). That's inherently racy — a "stop" could return before the old
# process tree was actually gone, so a fast toggle (or the extension's own
# polling) could end up stacking a second create_ap on the same interface.
#
# Systemd transient units fix this structurally instead of heuristically:
#   - `systemctl stop <unit>` blocks until the ENTIRE cgroup (create_ap's own
#     internal re-exec, hostapd, dnsmasq, all of it) is confirmed dead,
#     escalating to SIGKILL on a timeout if needed.
#   - `systemd-run --unit=<name> --collect ...` will simply refuse to start
#     a second instance under the same unit name while one is still active.
# So two create_ap processes for one hotspot is impossible by construction,
# not just "prevented if our bash logic happens to run correctly."
#
# Because everything here runs as root, every argument is strictly validated
# before being handed to create_ap. Arguments arrive as a real argv array
# (pkexec does not go through a shell), so there is no shell-injection
# surface, but create_ap itself parses its own argv, so we still reject
# values that look like flags (leading "-") and constrain charsets.

set -euo pipefail

STATE_DIR=/run/gnome-hotspot-toggle
STATUS_FILE="$STATE_DIR/status.json"
LOCK_FILE="$STATE_DIR/lock"

die() { echo "ERROR: $*" >&2; exit 1; }

# Still worth serializing our own start/stop calls even with systemd doing
# the heavy lifting underneath — avoids two pkexec invocations racing on
# the reset-failed/systemd-run sequence itself. (Read-only subcommands such
# as `leases` don't take the lock, so live monitoring never blocks a toggle.)
take_lock() {
    mkdir -p "$STATE_DIR"
    chmod 755 "$STATE_DIR"
    exec 9>"$LOCK_FILE"
    flock -w 20 9 || die "another hotspot start/stop is already in progress, try again in a moment"
}

# Locate create_ap. pkexec resets PATH to /usr/sbin:/usr/bin:/sbin:/bin, so
# /usr/local/bin has to be checked explicitly, and the distro packages /
# AppImage setup bundle a private copy that never clashes with a system one.
resolve_create_ap() {
    local p
    for p in "$(command -v create_ap 2>/dev/null || true)" \
             /usr/local/bin/create_ap \
             /usr/local/lib/hotspot-toggle/create_ap \
             /usr/lib/hotspot-toggle/create_ap; do
        if [[ -n "$p" && -x "$p" ]]; then
            echo "$p"
            return 0
        fi
    done
    return 1
}

is_iface() {
    local ifname=$1
    [[ "$ifname" =~ ^[A-Za-z0-9_.-]{1,15}$ ]] || return 1
    [[ -e "/sys/class/net/$ifname" ]]
}

require_not_flag() {
    local v=$1
    [[ "$v" != -* ]] || die "value '$v' must not start with '-'"
}

unit_name() {
    echo "gnome-hotspot-$1.service"
}

write_status() {
    # world-readable so the unprivileged extension can poll status without
    # needing another pkexec round-trip. The *live* on/off truth comes from
    # `systemctl is-active` (queried directly by the extension, no root
    # needed); this file just carries display metadata (SSID etc).
    local ifname=$1 ap_iface=$2 ssid=$3 internet=$4
    cat > "$STATUS_FILE.tmp" <<EOF
{
  "ifname": "$ifname",
  "ap_iface": "$ap_iface",
  "ssid": "$ssid",
  "internet": "$internet",
  "unit": "$(unit_name "$ifname")",
  "updated": "$(date -Is)"
}
EOF
    mv "$STATUS_FILE.tmp" "$STATUS_FILE"
    chmod 644 "$STATUS_FILE"
}

# Fully and synchronously tear down any existing unit for this interface.
stop_unit() {
    local ifname=$1
    local unit; unit=$(unit_name "$ifname")
    systemctl stop "$unit" >/dev/null 2>&1 || true
    # Clear "failed" state (e.g. from a previous crash) so systemd-run is
    # willing to reuse the unit name immediately.
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
}

cmd_start() {
    take_lock
    local ifname="" internet="" ssid="" password="" channel="1" wpa="2"
    local band="2.4" hidden="0" psk="0" novirt="0" isolate="0" mac=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ifname) ifname=$2; shift 2 ;;
            --internet) internet=$2; shift 2 ;;
            --ssid) ssid=$2; shift 2 ;;
            --password) password=$2; shift 2 ;;
            --channel) channel=$2; shift 2 ;;
            --wpa) wpa=$2; shift 2 ;;
            --band) band=$2; shift 2 ;;
            --hidden) hidden=$2; shift 2 ;;
            --psk) psk=$2; shift 2 ;;
            --no-virt) novirt=$2; shift 2 ;;
            --isolate) isolate=$2; shift 2 ;;
            --mac) mac=$2; shift 2 ;;
            *) die "unknown option $1" ;;
        esac
    done

    is_iface "$ifname" || die "invalid or missing WiFi interface: $ifname"

    if [[ -n "$internet" && "$internet" != "none" ]]; then
        is_iface "$internet" || die "invalid internet interface: $internet"
    fi

    [[ -n "$ssid" && ${#ssid} -le 32 ]] || die "SSID must be 1-32 chars"
    require_not_flag "$ssid"

    if [[ "$psk" == "1" ]]; then
        [[ "$password" =~ ^[0-9a-fA-F]{64}$ ]] || die "raw PSK must be exactly 64 hex digits"
    elif [[ -n "$password" ]]; then
        [[ ${#password} -ge 8 && ${#password} -le 63 ]] || die "password must be 8-63 chars"
        require_not_flag "$password"
    fi

    [[ "$channel" =~ ^[0-9]{1,3}$ && "$channel" -ge 1 && "$channel" -le 196 ]] || die "bad channel"
    [[ "$wpa" =~ ^(1|2|1\+2)$ ]] || die "bad wpa version"
    [[ "$band" =~ ^(2\.4|5)$ ]] || die "bad band"
    [[ "$hidden" =~ ^(0|1)$ ]] || die "bad hidden flag"
    [[ "$psk" =~ ^(0|1)$ ]] || die "bad psk flag"
    [[ "$novirt" =~ ^(0|1)$ ]] || die "bad no-virt flag"
    [[ "$isolate" =~ ^(0|1)$ ]] || die "bad isolate flag"
    if [[ -n "$mac" ]]; then
        [[ "$mac" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]] || die "bad MAC address"
    fi

    local create_ap_bin
    create_ap_bin=$(resolve_create_ap) || die "create_ap is not installed (see README)"
    command -v systemd-run >/dev/null 2>&1 || die "systemd-run not found; this helper requires systemd"

    local unit; unit=$(unit_name "$ifname")

    # Synchronous, verified teardown of any previous instance on this
    # interface before we even think about starting a new one.
    stop_unit "$ifname"

    local args=(-c "$channel" -w "$wpa" --freq-band "$band")
    [[ "$hidden" == "1" ]] && args+=(--hidden)
    [[ "$psk" == "1" ]] && args+=(--psk)
    [[ "$novirt" == "1" ]] && args+=(--no-virt)
    [[ "$isolate" == "1" ]] && args+=(--isolate-clients)
    [[ -n "$mac" ]] && args+=(--mac "$mac")
    # No --daemon/--pidfile/--logfile here: systemd itself supervises the
    # foreground process and captures its output in the journal
    # (`journalctl -u gnome-hotspot-<iface>.service`).

    if [[ -z "$internet" || "$internet" == "none" ]]; then
        args+=(-n "$ifname" "$ssid")
    else
        # Same interface for both = classic "AP + client at once on one
        # card" mode: create_ap spins up a virtual AP interface (unless
        # --no-virt is set) and shares whatever connection $ifname already
        # has as a client onto it.
        args+=("$ifname" "$internet" "$ssid")
    fi
    [[ -n "$password" ]] && args+=("$password")

    systemd-run \
        --unit="$unit" \
        --description="GNOME Hotspot ($ifname)" \
        --collect \
        --property=Restart=no \
        "$create_ap_bin" "${args[@]}"

    # Give hostapd/dnsmasq a moment to come up so status right after
    # toggling reflects reality instead of a still-starting unit.
    sleep 1

    local ap_iface
    ap_iface=$(journalctl -u "$unit" --no-pager -o cat 2>/dev/null \
        | grep -oE "AP-Enabling '[^']+'" | tail -n1 | sed -E "s/AP-Enabling '([^']+)'/\1/") || true
    [[ -z "$ap_iface" ]] && ap_iface="$ifname"

    write_status "$ifname" "$ap_iface" "$ssid" "${internet:-none}"
    echo "started"
}

cmd_stop() {
    take_lock
    local ifname=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ifname) ifname=$2; shift 2 ;;
            *) die "unknown option $1" ;;
        esac
    done
    is_iface "$ifname" || die "invalid interface: $ifname"

    stop_unit "$ifname"
    write_status "$ifname" "" "" ""
    echo "stopped"
}

# Print create_ap's dnsmasq lease file(s) for an interface so unprivileged
# monitoring (`hotspot-toggle info`) can show device names. The lease files
# live in root-only temp dirs created by create_ap. /tmp is world-writable,
# so only read directories/files that are (a) not symlinks and (b) owned by
# root — otherwise a local user could plant a symlink and read any file.
cmd_leases() {
    local ifname=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ifname) ifname=$2; shift 2 ;;
            *) die "unknown option $1" ;;
        esac
    done
    is_iface "$ifname" || die "invalid interface: $ifname"

    local d f
    for d in /tmp/create_ap."$ifname".conf.*; do
        [[ -d "$d" && ! -L "$d" && "$(stat -c %u "$d")" == "0" ]] || continue
        f="$d/dnsmasq.leases"
        [[ -f "$f" && ! -L "$f" && "$(stat -c %u "$f")" == "0" ]] || continue
        cat -- "$f"
    done
}

case "${1:-}" in
    start) shift; cmd_start "$@" ;;
    stop) shift; cmd_stop "$@" ;;
    leases) shift; cmd_leases "$@" ;;
    *) die "usage: $0 {start|stop|leases} [options]" ;;
esac
