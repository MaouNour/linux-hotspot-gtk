<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>gnome-hotspot-toggle</vendor>

  <action id="local.hotspot-toggle.manage">
    <description>Manage the WiFi hotspot (create_ap via systemd)</description>
    <message>Authentication is required to turn the WiFi hotspot on or off</message>
    <icon_name>network-wireless-hotspot-symbolic</icon_name>
    <defaults>
      <!-- Same pattern used by the linux-wifi-hotspot project's own
           polkit policy: admins get in with just their own password
           (allow_active=auth_admin), and the .rules file below grants an
           instant pass with no prompt at all to anyone already in the
           sudo/wheel group, since on a typical single-user desktop that's
           just... you. -->
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <!-- This annotation is what lets `pkexec /usr/local/bin/gnome-hotspot-helper`
         resolve to this action instead of the generic "run any command"
         action (which normally requires full admin auth with no group
         bypass support). -->
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/gnome-hotspot-helper</annotate>
  </action>
</policyconfig>
